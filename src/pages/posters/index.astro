---
import Layout from '../../layouts/Layout.astro';

const posters = [
  {
    id: 'gouden-wielwebspin',
    title: 'Gouden Wielwebspin',
    subtitle: 'Nephila clavipes',
    description: 'De gouden wielwebspin is beroemd om haar prachtige, goudkleurige zijde. Deze tropische spin weeft enkele van de grootste en sterkste webben in de spinnenwereld.',
    image: '/spinnen-posters/images/posters/gouden-wielwebspin.png',
    facts: ['Web kan tot 2 meter breed zijn', 'Gouden zijde wordt gebruikt in textiel', 'Vrouwtjes zijn 10x groter dan mannetjes']
  },
  {
    id: 'springende-spin',
    title: 'Springende Spin',
    subtitle: 'Salticidae',
    description: 'Met hun grote, expressieve ogen en nieuwsgierige aard zijn springende spinnen de charmantste van alle spinnen. Ze jagen actief en kunnen tot 50 keer hun eigen lichaamslengte springen.',
    image: '/spinnen-posters/images/posters/springende-spin.png',
    facts: ['Beste zicht van alle spinnen', 'Meer dan 6.000 soorten', 'Kunnen kleuren zien']
  },
  {
    id: 'zwarte-weduwe',
    title: 'Zwarte Weduwe',
    subtitle: 'Latrodectus mactans',
    description: 'De iconische zwarte weduwe met haar kenmerkende rode zandlopervormige markering. Ondanks haar reputatie is ze schuw en bijt alleen als ze zich bedreigd voelt.',
    image: '/spinnen-posters/images/posters/zwarte-weduwe.png',
    facts: ['Gif 15x sterker dan ratelslang', 'Mannetje wordt zelden opgegeten', 'Leeft tot 3 jaar']
  },
  {
    id: 'blauwe-vogelspinnen',
    title: 'Blauwe Vogelspin',
    subtitle: 'Chromatopelma cyaneopubescens',
    description: 'De Greenbottle Blue tarantula uit Venezuela is een van de meest kleurrijke spinnen ter wereld, met een verbluffende combinatie van kobaltblauw, oranje en groen.',
    image: '/spinnen-posters/images/posters/blauwe-vogelspinnen.png',
    facts: ['Komt alleen voor in Venezuela', 'Blauw komt door lichtbreking', 'Kan 15 jaar oud worden']
  },
  {
    id: 'kruisspin',
    title: 'Kruisspin',
    subtitle: 'Araneus diadematus',
    description: 'De bekendste spin van Nederland en België, herkenbaar aan het witte kruis op haar achterlijf. Ze bouwt iedere dag een nieuw, perfect geometrisch web.',
    image: '/spinnen-posters/images/posters/kruisspin.png',
    facts: ['Bouwt dagelijks nieuw web', 'Eet haar oude web op', 'Meest voorkomend in september']
  }
];
---

<Layout title="Alle Posters" description="Bekijk onze complete collectie spinnenposters">
  <section class="py-12 sm:py-20 bg-web-pattern min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-8 sm:mb-12">
        <p class="text-purple-400 font-medium tracking-widest uppercase mb-2 text-sm">Collectie</p>
        <h1 class="text-3xl sm:text-5xl font-black mb-4">Alle Posters</h1>
        <p class="text-gray-400 text-base sm:text-xl max-w-2xl leading-relaxed">
          Ontdek onze complete collectie van hoogwaardige spinnenposters. 
          Elk exemplaar is zorgvuldig samengesteld om de schoonheid van deze 
          fascinerende wezens vast te leggen. Van close-up portretten tot 
          dramatische composities — er is voor ieder wat wils.
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-8">
        {posters.map(poster => (
          <a href={`/spinnen-posters/posters/${poster.id}/`} class="poster-card group gradient-border overflow-hidden">
            <div class="aspect-[2/3] overflow-hidden">
              <img 
                src={poster.image} 
                alt={poster.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-4 sm:p-6">
              <h2 class="text-xl sm:text-2xl font-bold mb-1">{poster.title}</h2>
              <p class="text-purple-400 italic mb-2 sm:mb-3 text-sm">{poster.subtitle}</p>
              <p class="text-gray-400 text-sm line-clamp-3">{poster.description}</p>
              <div class="mt-3 sm:mt-4 flex items-center gap-2 text-purple-400 group-hover:text-purple-300">
                <span class="font-medium text-sm sm:text-base">Bekijk poster</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
