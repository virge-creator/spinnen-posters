---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const title = frontmatter?.title || "Nieuws";
const description = frontmatter?.description || "";
const date = frontmatter?.date || new Date().toISOString();

const formattedDate = new Date(date).toLocaleDateString('nl-NL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={title} description={description}>
  <article class="py-20 bg-web-pattern min-h-screen">
    <div class="max-w-4xl mx-auto px-6">
      <a href="/spinnen-posters/nieuws/" class="inline-flex items-center gap-2 text-purple-400 hover:text-purple-300 mb-8">
        ← Terug naar nieuws
      </a>
      
      <header class="mb-12">
        <p class="text-purple-400 text-sm uppercase tracking-widest mb-4">{formattedDate}</p>
        <h1 class="text-4xl md:text-5xl font-black mb-4">{title}</h1>
        <p class="text-xl text-gray-400">{description}</p>
      </header>
      
      <div class="prose prose-lg prose-invert prose-purple max-w-none">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .prose {
    color: #d1d5db;
  }
  .prose h2 {
    color: white;
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose h3 {
    color: white;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    margin-bottom: 1.5rem;
    line-height: 1.8;
  }
  .prose a {
    color: #a78bfa;
    text-decoration: underline;
  }
  .prose a:hover {
    color: #c4b5fd;
  }
  .prose strong {
    color: white;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose blockquote {
    border-left: 4px solid #8b5cf6;
    padding-left: 1.5rem;
    font-style: italic;
    color: #9ca3af;
  }
</style>
