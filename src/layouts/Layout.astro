---
import '../styles/global.css'

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Spinnen Posters - Prachtige posters van spinnen voor thuis of kantoor" } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/spinnen-posters/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <title>{title} | Spinnen Posters</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <header class="border-b border-gray-800 bg-gray-950/80 backdrop-blur-sm sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <a href="/spinnen-posters/" class="text-2xl font-bold flex items-center gap-2">
            <span class="text-3xl">🕷️</span>
            <span>Spinnen Posters</span>
          </a>
          <div class="flex items-center gap-8">
            <a href="/spinnen-posters/" class="text-gray-400 hover:text-white transition-colors">Home</a>
            <a href="/spinnen-posters/posters/" class="text-gray-400 hover:text-white transition-colors">Posters</a>
            <a href="/spinnen-posters/nieuws/" class="text-gray-400 hover:text-white transition-colors">Nieuws</a>
            <a href="/spinnen-posters/over/" class="text-gray-400 hover:text-white transition-colors">Over</a>
          </div>
        </div>
      </nav>
    </header>
    
    <main class="flex-grow">
      <slot />
    </main>
    
    <footer class="border-t border-gray-800 py-8 mt-20">
      <div class="max-w-6xl mx-auto px-6 text-center text-gray-500">
        <p>© 2026 Spinnen Posters — Met liefde voor achtpotige vrienden 🕸️</p>
      </div>
    </footer>
  </body>
</html>
